{{/* Define all novel JSON URLs */}}
{{ $novelUrls := dict 
  "4183" "https://github.com/YuushaExa/trnsl/raw/refs/heads/main/data/4183_translated.json"
}}   
{{ range $novelId, $url := $novelUrls }}    
  {{/* Fetch remote JSON */}}
  {{ $remoteData := resources.GetRemote $url (dict "headers" (dict "Accept" "application/json")) }}
  {{ if $remoteData }} 
    {{ $data := $remoteData.Content | transform.Unmarshal }}
    
    {{/* Process chapters - note $data is an array */}} 
    {{ range $index, $chapter := $data }}
      {{ $content := $chapter.content 
                    | replaceRE `\\r\\n` "\n"   
                    | replaceRE `\r\n` "\n"   
                    | replaceRE `\n+` "\n\n" }}
        
      {{ $page := dict
        "content" (dict "mediaType" "text/markdown" "value" $content)
        "kind" "page"
        "params" (dict 
          "title" $chapter.title
          "chapter" (add $index 1)
          "id" $novelId
          "novel_id" $novelId
          "translation_model" $chapter.model
        )
        "path" (printf "%s/%d" $novelId (add $index 1))
        "title" $chapter.title
      }}
      {{ $.AddPage $page }}
    {{ end }}
  {{ else }}
    {{ warnf "Failed to fetch novel: %s from %s" $novelId $url }}
  {{ end }}
{{ end }}
